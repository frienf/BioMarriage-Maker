# Postgres. `docker compose up -d postgres` gives you this exact URL.
DATABASE_URL=postgres://biodata:biodata@localhost:5432/biodata

# Public origin. The PDF renderer loads the print page from here.
APP_ORIGIN=http://localhost:3000

# Razorpay. Test keys look like rzp_test_xxx. Never commit the secret.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Where rendered PDFs are cached. Must not be web-served.
STORAGE_DIR=./storage
