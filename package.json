{
  "name": "biodata-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "db:push": "drizzle-kit push",
    "pdf:install": "playwright install chromium",
    "sweep": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/sweep.ts",
    "proofs": "node --experimental-strip-types scripts/proof-sheet.ts",
    "fit": "node --experimental-strip-types scripts/fit-check.ts",
    "e2e": "node --env-file=.env.local --experimental-strip-types scripts/e2e-check.ts",
    "motion": "node --experimental-strip-types scripts/motion-check.ts",
    "brand": "node --experimental-strip-types scripts/brand-check.ts",
    "thumbs": "node --experimental-strip-types scripts/template-thumbs.ts",
    "gen:images": "node scripts/gen-template-images.mjs",
    "frames": "node --experimental-strip-types scripts/prepare-frames.ts",
    "frames:check": "node --experimental-strip-types scripts/frame-check.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "chrome-devtools-mcp": "^1.12.0",
    "drizzle-orm": "^0.44.6",
    "gsap": "^3.15.0",
    "motion": "^14.4.0",
    "next": "15.5.4",
    "next-intl": "^4.3.12",
    "playwright": "^1.56.0",
    "postgres": "^3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.186.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.4",
    "sharp": "0.34.5",
    "typescript": "^5.9.3"
  }
}
